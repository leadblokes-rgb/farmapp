{
  "name": "farmmatch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
