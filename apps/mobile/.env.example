# Copy to .env.local. Values come from `npx supabase status` (run from the repo root).
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP (e.g. http://192.168.1.20:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Show one-tap sign-in buttons for the seeded demo accounts (development builds only).
# Leave it off when testing with real farms.
EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS=true
